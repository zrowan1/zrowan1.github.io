# Copy to .env and adjust. All values are optional and have sensible defaults.

# HTTP
PORT=3000
HOST=0.0.0.0
TZ=Europe/Amsterdam

# Session signing. Set a long, random, stable value so logins survive restarts.
# If unset, a random key is generated once and stored in DATA_DIR/session.key.
SESSION_SECRET=

# First-boot seed passwords for the two users (only used when the DB is empty).
SEED_ROWAN_PASSWORD=rowan
SEED_JAMIE_PASSWORD=jamie

# Daily reminder cron expression (local time / TZ above). Default 07:00.
REMINDER_CRON=0 7 * * *

# Cookies: set true only behind HTTPS.
COOKIE_SECURE=false

# Web Push (VAPID). Leave empty to auto-generate + persist in DATA_DIR/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@huishouden.local

# Where the SQLite db + generated secrets are stored (mounted volume in Docker).
DATA_DIR=/data
